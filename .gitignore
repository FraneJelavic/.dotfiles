**/node_modules/

# Deliberately local shell, Git, and tool configuration.
/home/.bash_profile
/home/.bashrc
/home/.gitconfig
/home/.testcontainers.properties
/home/.zprofile
/home/.zsh_profile
/home/.zshrc
/home/.config/git/config
