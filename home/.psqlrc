\set QUIET 1

-- Behaviour
\set ON_ERROR_ROLLBACK interactive
\set COMP_KEYWORD_CASE upper
\set VERBOSITY verbose
\set HISTCONTROL ignoredups
\set HISTSIZE 10000
\set FETCH_COUNT 1000

-- Display
\x auto
\timing
\pset null '[null]'
\pset linestyle unicode
\pset border 2
\pset format wrapped
\pset columns 0
\pset footer off

-- Prompt and display settings
\set PROMPT1 '%[%033[1;32m%]%/%[%033[0m%]%x%[%033[1;33m%]%R%#%[%033[0m%] '
\set PROMPT2 '%[%033[1;32m%]%/%[%033[0m%]%x%[%033[1;33m%]%R%#%[%033[0m%] '

-- Use sensible pager
\pset pager on
\setenv PAGER 'less -iMFXSx4R'

-- Stop hiding confirmation messages
\unset QUIET

-- vim: set ft=sql:
